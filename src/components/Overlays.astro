<!-- ======== OVERLAYS (Easter eggs) ======== -->
<canvas id="matrix-canvas" aria-hidden="true"></canvas>
<canvas id="spark-canvas" aria-hidden="true"></canvas>
<div id="boo-flash" aria-hidden="true"></div>

<div id="toast" role="status" aria-live="polite"></div>

<div class="tty-overlay" id="tty-overlay" aria-hidden="true">
    <div class="tty" role="dialog" aria-label="Hidden terminal">
        <div class="tty-head">
            <span class="tty-title">dsmans@portfolio: <b>~</b></span>
            <button class="tty-close" id="tty-close" aria-label="Close terminal">&times;</button>
        </div>
        <div class="tty-body" id="tty-out"></div>
        <div class="tty-in">
            <span class="tty-prompt">dsmans@portfolio:~$</span>
            <input class="tty-input" id="tty-input" autocomplete="off" spellcheck="false" aria-label="Terminal command">
        </div>
    </div>
</div>