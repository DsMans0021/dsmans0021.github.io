<!-- MORE ABOUT ME -->
<section id="more">
    <div class="container">
        <p class="section-label">// 05</p>
        <h2 class="section-title" data-i18n="more.title">More about me</h2>
        <p class="section-sub" data-i18n="more.sub">The personality part — what I listen to, play, quote, and run my work on. Optional reading, but fun.</p>
        <div class="more-grid">
            <div class="more-block reveal" id="quotes">
                <div class="more-block-label" data-i18n="more.quotesLabel">// words to live by</div>
                <div class="more-block-title" data-i18n="more.quotesTitle">Favorite quotes</div>
                <div class="quote-display">
                    <div class="quote-mark" aria-hidden="true">"</div>
                    <div class="quote-text" id="quote-text">Loading...</div>
                    <div class="quote-author" id="quote-author"></div>
                    <div class="quote-source" id="quote-source"></div>
                    <div class="quote-controls">
                        <span class="quote-counter" id="quote-counter">1 / 200</span>
                        <button class="quote-btn" id="quote-prev" aria-label="Previous quote"><i class="fa-solid fa-chevron-left"></i></button>
                        <button class="quote-btn" id="quote-next" aria-label="Next quote"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>
            <div class="more-block reveal" id="music">
                <div class="more-block-label" data-i18n="more.musicLabel">// now playing</div>
                <div class="more-block-title" data-i18n="more.musicTitle">What I'm listening to</div>
                <div class="embed-wrap">
                    <iframe title="Mohamed Abdelaziz Spotify playlist" src="https://open.spotify.com/embed/playlist/2RAfvrJZQ7uq9Wcwbv9AU8?utm_source=generator&theme=0" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
                </div>
            </div>
            <div class="more-block reveal" id="projects-link-block">
                <div class="more-block-label" data-i18n="more.playLabel">// play</div>
                <div class="more-block-title" data-i18n="more.playTitle">Want to play Maya?</div>
                <p class="more-block-desc" data-i18n="more.playDesc">Play my latest game directly from the projects section.</p>
                <a href="#projects" class="btn-outline"><i class="fa-solid fa-gamepad"></i> <span data-i18n="more.playBtn">Jump to projects</span></a>
            </div>
        </div>
    </div>
</section>
