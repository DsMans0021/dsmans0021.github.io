---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Achievements from '../components/Achievements.astro';
import More from '../components/More.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="progress-bar" aria-hidden="true"></div>

    <Nav />

    <main id="main">
        <Hero />
        <About />
        <Projects />
        <Skills />
        <Achievements />
        <More />
        <Contact />
    </main>

    <Footer />

    <button class="back-to-top" id="back-to-top" aria-label="Back to top"><i class="fa-solid fa-chevron-up"></i></button>

    <script>
        import '../scripts/app.ts';
    </script>
</Base>